package main

import (
	"context"
	"encoding/gob"
	"log/slog"
	"net"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"github.com/google/uuid"
	"github.com/saryginrodion/netmon/internal/collectors/activetcp"
)

type TypeWithAriphmeticOperations interface {
	~int | ~uint | ~float32 | ~float64 | ~int64
}

type AggregatedAriphmeticOpsMetric[T TypeWithAriphmeticOperations] struct {
	count    int
	accValue T
}

func (am *AggregatedAriphmeticOpsMetric[T]) Add(dur T) {
	am.count++
	am.accValue += dur
}

func (am *AggregatedAriphmeticOpsMetric[T]) Value() T {
	return am.accValue / T(am.count)
}

type AggregatedMetrics struct {
	rtt        AggregatedAriphmeticOpsMetric[time.Duration]
	toServer   AggregatedAriphmeticOpsMetric[time.Duration]
	fromServer AggregatedAriphmeticOpsMetric[time.Duration]
}

type MetricEntry struct {
	time       time.Time
	rtt        time.Duration
	toServer   time.Duration
	fromServer time.Duration
}

type Metrics struct {
	sync.Mutex
	entries []MetricEntry
}

func (m *Metrics) Add(entry MetricEntry) {
	m.Lock()
	m.entries = append(m.entries, entry)
	m.Unlock()
}

func (m *Metrics) Calculate(now time.Time, dur time.Duration) AggregatedMetrics {
	m.Lock()
	entries := append([]MetricEntry{}, m.entries...)
	m.Unlock()

	aggregatedMetrics := AggregatedMetrics{
		rtt:        AggregatedAriphmeticOpsMetric[time.Duration]{},
		toServer:   AggregatedAriphmeticOpsMetric[time.Duration]{},
		fromServer: AggregatedAriphmeticOpsMetric[time.Duration]{},
	}

	for i := len(entries); i >= 0; i-- {
		entry := entries[i]
		if now.Add(-dur).After(entry.time) {
			break
		}

		aggregatedMetrics.rtt.Add(entry.rtt)
		aggregatedMetrics.toServer.Add(entry.toServer)
		aggregatedMetrics.fromServer.Add(entry.fromServer)
	}

	return aggregatedMetrics
}

func (m *Metrics) DeleteOld(now time.Time, dur time.Duration) {
	m.Lock()
	defer m.Unlock()

	for i := len(m.entries); i >= 0; i-- {
		entry := m.entries[i]
		if now.Add(-dur).After(entry.time) {
			m.entries = m.entries[i+1 : len(m.entries)]
			break
		}
	}
}

const CONNECTION_ADDR = "localhost:8001"
const PACKET_RATE = time.Second / 100

func main() {
	log := slog.New(slog.NewTextHandler(os.Stdout, &slog.HandlerOptions{
		Level: slog.LevelInfo,
	}))
	log.WithGroup("tcp-server")

	conn, err := net.Dial("tcp", CONNECTION_ADDR)
	if err != nil {
		log.Error("unable to dial TCP connection", "err", err)
		os.Exit(1)
	}

	log.Debug("opened tcp connection", "addr", CONNECTION_ADDR)

	metrics := Metrics{}

	// connection handling
	ctx, cancel := context.WithCancel(context.Background())
	go func() {
		log := log.With("scope", "connectionHandleLoop")
		go handleConn(ctx, log, conn, &metrics)
	}()

	// Graceful shutdown
	killSig := make(chan os.Signal, 1)
	signal.Notify(killSig, syscall.SIGINT, syscall.SIGTERM)

	<-killSig

	log.Debug("shutting down")
	cancel()

	if err := conn.Close(); err != nil {
		log.Error("listener closed with error", "err", err)
	}
}

func handleConn(ctx context.Context, logger *slog.Logger, conn net.Conn, metrics *Metrics) {
	defer conn.Close()

	log := logger.With(
		"scope", "handleConn",
		"remoteAddr", conn.RemoteAddr(),
		"localAddr", conn.LocalAddr(),
	)

	log.Debug("starting connection handling")

	isRunning := true

	ticker := time.NewTicker(PACKET_RATE)

	enc := gob.NewEncoder(conn)
	dec := gob.NewDecoder(conn)

	for range ticker.C {
		select {
		case <-ctx.Done():
			isRunning = false
		default:
		}

		if !isRunning {
			ticker.Stop()
			break
		}

		request := activetcp.TCPMessage{
			MessageID: uuid.New(),
			ReplyTo:   nil,
			Timestamp: time.Now(),
			Data:      map[string]any{},
		}

		err := enc.Encode(request)
		if err != nil {
			log.Warn("failed to send message", "err", err)
			break
		}

		response := &activetcp.TCPMessage{}
		err = dec.Decode(response)
		if err != nil {
			log.Warn("failed to read response", "err", err)
			break
		}

		latencyToServer := response.Timestamp.Sub(request.Timestamp)
		latencyFromServer := time.Since(response.Timestamp)

		metrics.Add(MetricEntry{
			time:       time.Now(),
			rtt:        latencyFromServer + latencyToServer,
			toServer:   latencyToServer,
			fromServer: latencyFromServer,
		})
		log.Debug("received message",
			"message", response,
			"rtt", latencyFromServer+latencyToServer,
			"latencyToClient", latencyFromServer,
			"latencyToServer", latencyToServer,
		)
	}
}

func startPrintingMetrics(ctx context.Context, logger *slog.Logger, metrics *Metrics, interval time.Duration) {
	log := logger.With("scope", "startPrintingMetrics", "interval", interval)
	ticker := time.NewTicker(interval)

	for range ticker.C {
		select {
		case <-ctx.Done():
			ticker.Stop()
			return
		default:
		}

		now := time.Now()
		vals := metrics.Calculate(now, interval)

		log.Info("metrics",
			"rtt", vals.rtt.Value(),
		)
	}
}
